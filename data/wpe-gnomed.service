[Unit]
Description=Wallpaper Engine wallpapers for GNOME
Documentation=https://github.com/realistik/wpe-gnome
PartOf=graphical-session.target
After=graphical-session.target
# GNOME Shell must be up so that the extension can answer the first pin.
After=org.gnome.Shell@wayland.service
ConditionEnvironment=XDG_CURRENT_DESKTOP=GNOME

[Service]
Type=dbus
BusName=io.github.realistik.WpeGnome.Daemon
ExecStart=@BINDIR@/wpe-gnomed
Restart=on-failure
RestartSec=2
RestartSteps=5
RestartMaxDelaySec=30
# Renderers live in the service's cgroup: stopping the service stops every renderer.
KillMode=control-group
Slice=background.slice

[Install]
WantedBy=graphical-session.target
