[Desktop Entry]
Name=Wallpaper Engine
Comment=Use Steam Wallpaper Engine wallpapers as live GNOME backgrounds
Exec=wpe-gnome
Icon=io.github.realistik.WpeGnome
Terminal=false
Type=Application
Categories=GNOME;GTK;Settings;DesktopSettings;
Keywords=wallpaper;background;live;steam;
StartupNotify=true
DBusActivatable=false
X-GNOME-UsesNotifications=false
